@page "/ClientAuto"
@rendermode @(new InteractiveAutoRenderMode(prerender: true))
@using Microsoft.Extensions.Logging
@inject ILogger<ClientAuto> Logger
@using static BlazorApp.Shared.Logging

<PageTitle>Client Auto</PageTitle>

<h1>Client Auto</h1>
<h3>Machine: @Environment.MachineName</h3>
<p>OnInitialized called @onInitializedCount time(s)</p>

@code {
    [PersistentState]
    public int onInitializedCount { get; set; }
    protected override void OnInitialized()
    {
        onInitializedCount++;
        Log(Logger, RendererInfo, "ClientAuto", true, "OnInitialized");
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Log(Logger, RendererInfo, "ClientAuto", true, $"OnAfterRender(firstRender: {firstRender})");
    }

    public ClientAuto()
    {
        this.onInitializedCount = 0;
    }
}