@page "/clientauto"
@rendermode @(new InteractiveAutoRenderMode(prerender: true))

<PageTitle>ClientAuto</PageTitle>

<h1>ClientAuto</h1>
<h3>Environment.MachineName: @_machineName</h3>
<button @onclick="click">B</button>
<p>@_name</p>

@code {
    private string _name = "";
    private string _machineName = "";
    void click()
    {
        _name = Environment.MachineName;
    }
    protected override void OnInitialized()
    {
        _machineName = Environment.MachineName;
    }
}
