@page "/ClientAuto"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))

<PageTitle>Client Auto</PageTitle>

<h1>Client Auto</h1>
<h3>Machine: @Environment.MachineName</h3>
<p>OnInitialized called @onInitializedCount time(s)</p>

@code {
    [PersistentState]
    public int onInitializedCount { get; set; }
    protected override void OnInitialized()
    {
        onInitializedCount++;
        if (OperatingSystem.IsBrowser())
        {
            System.Console.WriteLine($"onInitializedCount: {onInitializedCount}");
        }
    }

    public ClientAuto()
    {
        this.onInitializedCount = 0;
    }
}