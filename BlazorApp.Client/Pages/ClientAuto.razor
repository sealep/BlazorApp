@page "/ClientAuto"
@rendermode @(new InteractiveAutoRenderMode(prerender: true))
@using Microsoft.Extensions.Logging
@inject ILogger<ClientAuto> Logger
@using static BlazorApp.Shared.Logging

<PageTitle>Client Auto</PageTitle>

<h1>Client Auto</h1>
<h3>Machine: @Environment.MachineName</h3>
<p>OnInitialized called @onInitializedCount time(s)</p>
<button @onclick="click">Button</button>
<p>@done</p>

@code {
    [PersistentState]
    public int onInitializedCount { get; set; }
    public bool done = false;

    protected override async Task OnInitializedAsync()
    {
        onInitializedCount++;
        Log(Logger, RendererInfo, "ClientAuto", true, "OnInitializedAsync");
        await Task.Delay(2000);
        done = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Log(Logger, RendererInfo, "ClientAuto", true, $"OnAfterRender(firstRender: {firstRender})");
    }
    public void click()
    {
        Log(Logger, RendererInfo, "ClientAuto", true, "click");
    }
    public ClientAuto()
    {
        this.onInitializedCount = 0;
     
    }
}