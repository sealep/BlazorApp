@page "/ClientAuto"
@rendermode @(new InteractiveAutoRenderMode(prerender: true))

<PageTitle>Client Auto</PageTitle>

<h1>Client Auto</h1>
<p>OnInitialized called @onInitializedCount time(s)</p>
<button @onclick="Click">Click Me</button>

@code {
    private int onInitializedCount = 0;
    protected override void OnInitialized()
    {
        onInitializedCount++;
    }
    private void Click()
    {
        
    }
}