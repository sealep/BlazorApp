@page "/ClientWASM"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: true))

<PageTitle>Client WASM</PageTitle>

<h1>Client WASM</h1>
<p>OnInitialized called @onInitializedCount time(s)</p>

@code {
    [PersistentState]
    public int onInitializedCount { get; set; }
    protected override void OnInitialized()
    {
        onInitializedCount++;
    }

    public ClientWASM()
    {
        this.onInitializedCount = 0;
    }
}