@page "/ClientWASM"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: true))
@using Microsoft.Extensions.Logging
@inject ILogger<ClientWASM> Logger

<PageTitle>Client WASM</PageTitle>

<h1>Client WASM</h1>
<h3>Machine: @Environment.MachineName</h3>
<p>OnInitialized called @onInitializedCount time(s)</p>

@code {
    [PersistentState]
    public int onInitializedCount { get; set; }
    protected override void OnInitialized()
    {
        onInitializedCount++;
        if (OperatingSystem.IsBrowser())
        {
            Logger.LogInformation($"ServerInteractive onInitializedCount: {onInitializedCount}");
            Logger.LogInformation($"ServerInteractive IsInteractive: {RendererInfo.IsInteractive}");
        }
        else
        {
            Logger.LogInformation($"ClientWASM onInitializedCount: {onInitializedCount}");
            Logger.LogInformation($"ClientWASM IsInteractive: {RendererInfo.IsInteractive}");

        }
    }

    public ClientWASM()
    {
        this.onInitializedCount = 0;
    }
}