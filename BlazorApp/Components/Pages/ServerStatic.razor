@page "/ServerStatic"
@using Microsoft.Extensions.Logging
@inject ILogger<ServerStatic> Logger

<PageTitle>Server Static</PageTitle>

<h1>Server Static</h1>
<h3>Machine: @Environment.MachineName</h3>
<p>OnInitialized called @onInitializedCount time(s)</p>

@code {
    public int onInitializedCount { get; set; }
    protected override void OnInitialized()
    {
        onInitializedCount++;
        if (OperatingSystem.IsBrowser())
        {
            System.Console.WriteLine($"ServerStatic onInitializedCount: {onInitializedCount}");
        }
        else
        {
            Logger.LogInformation($"ServerStatic onInitializedCount: {onInitializedCount}");
        }
    }

    public ServerStatic()
    {
        this.onInitializedCount = 0;
    }
}