@page "/ServerStatic"

<PageTitle>Server Static</PageTitle>

<h1>Server Static</h1>
<p>OnInitialized called @onInitializedCount time(s)</p>

@code {
    public int onInitializedCount { get; set; }
    protected override void OnInitialized()
    {
        onInitializedCount++;
        if (OperatingSystem.IsBrowser())
        {
            System.Console.WriteLine($"onInitializedCount: {onInitializedCount}");
        }
    }

    public ServerStatic()
    {
        this.onInitializedCount = 0;
    }
}