@page "/ServerInteractive"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Microsoft.Extensions.Logging
@inject ILogger<ServerInteractive> Logger

<PageTitle>Server Interactive</PageTitle>

<h1>Server Interactive</h1>
<h3>Machine: @Environment.MachineName</h3>
<p>OnInitialized called @onInitializedCount time(s)</p>

@code {
    [PersistentState]
    public int onInitializedCount { get; set; }
    protected override void OnInitialized()
    {
        onInitializedCount++;
        if (OperatingSystem.IsBrowser())
        {
            System.Console.WriteLine($"onInitializedCount: {onInitializedCount}");
        }
        else
        {
            Logger.LogInformation($"onInitializedCount: {onInitializedCount}");
        }
    }

    public ServerInteractive()
    {
        this.onInitializedCount = 0;
    }
}