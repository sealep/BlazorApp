@page "/ServerInteractive"
@rendermode @(new InteractiveServerRenderMode(prerender: true))

<PageTitle>Server Interactive</PageTitle>

<h1>Server Interactive</h1>
<p>OnInitialized called @onInitializedCount time(s)</p>
<button @onclick="Click">Click Me</button>

@code {
    [PersistentState]
    public int onInitializedCount { get; set; } = 0;
    protected override void OnInitialized()
    {
        onInitializedCount++;
    }
    private void Click()
    {

    }
}